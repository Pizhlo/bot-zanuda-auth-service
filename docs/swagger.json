{
    "swagger": "2.0",
    "info": {
        "description": "API для работы с авторизацией",
        "title": "Auth Service API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/api/v0/auth/notes/filter": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Фильтрует входящий список айди заметок, возвращая только те, которые доступны пользователю (в соответствии с политиками).",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "notes"
                ],
                "summary": "Фильтрация записей, доступных пользователю",
                "parameters": [
                    {
                        "description": "Запрос на фильтрацию заметок",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/auth-service_internal_model.FilterNotesRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/auth-service_internal_model.FilterNotesResponse"
                        }
                    },
                    "400": {
                        "description": "Некорректный запрос",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "401": {
                        "description": "Пользователь не авторизован",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "403": {
                        "description": "Нет доступа к запрошенным заметкам",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/v0/decisions/check": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Проверка отношений и всей маски полей с сохранением решения в PostgreSQL. Deny возвращается с HTTP 200. При include_reasons причины содержат проверенные relation/object/subject и имена запрошенных полей. Ошибка 400 указывает в message проблемный заголовок или JSON-путь и ограничение, включая ошибки UUID и типов.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "decisions"
                ],
                "summary": "Проверить одно действие",
                "parameters": [
                    {
                        "type": "string",
                        "description": "UUID для корреляции отказа до чтения тела",
                        "name": "X-Request-ID",
                        "in": "header"
                    },
                    {
                        "type": "string",
                        "description": "Доверенный Telegram ID",
                        "name": "X-Telegram-User-Id",
                        "in": "header",
                        "required": true
                    },
                    {
                        "description": "Одно действие",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/auth-service_internal_model.CheckDecisionRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/auth-service_internal_model.CheckDecisionResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/auth-service_internal_api_internal_response.DecisionErrorBody"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/auth-service_internal_api_internal_response.DecisionErrorBody"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/auth-service_internal_api_internal_response.DecisionErrorBody"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/auth-service_internal_api_internal_response.DecisionErrorBody"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/auth-service_internal_api_internal_response.DecisionErrorBody"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/auth-service_internal_api_internal_response.DecisionErrorBody"
                        }
                    }
                }
            }
        },
        "/api/v0/health": {
            "get": {
                "description": "Проверить состояние сервера и соединения",
                "summary": "Проверить состояние сервера и соединения",
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        }
    },
    "definitions": {
        "auth-service_internal_api_internal_response.DecisionErrorBody": {
            "type": "object",
            "required": [
                "error_code",
                "message"
            ],
            "properties": {
                "error_code": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                },
                "request_id": {
                    "type": "string"
                }
            }
        },
        "auth-service_internal_model.ActionName": {
            "type": "string",
            "enum": [
                "create",
                "update",
                "delete",
                "read",
                "stop",
                "add",
                "edit",
                "remove"
            ],
            "x-enum-varnames": [
                "ActionNameCreate",
                "ActionNameUpdate",
                "ActionNameDelete",
                "ActionNameRead",
                "ActionNameStop",
                "ActionNameAdd",
                "ActionNameEdit",
                "ActionNameRemove"
            ]
        },
        "auth-service_internal_model.CheckDecisionRequest": {
            "additionalProperties": false,
            "type": "object",
            "required": [
                "action",
                "request_id",
                "resource",
                "subject"
            ],
            "properties": {
                "action": {
                    "$ref": "#/definitions/auth-service_internal_model.DecisionAction"
                },
                "context": {
                    "$ref": "#/definitions/auth-service_internal_model.DecisionContext"
                },
                "options": {
                    "$ref": "#/definitions/auth-service_internal_model.DecisionOptions"
                },
                "request_id": {
                    "type": "string"
                },
                "resource": {
                    "$ref": "#/definitions/auth-service_internal_model.DecisionResource"
                },
                "subject": {
                    "$ref": "#/definitions/auth-service_internal_model.DecisionSubject"
                }
            }
        },
        "auth-service_internal_model.CheckDecisionResponse": {
            "type": "object",
            "required": [
                "allow",
                "decision_id",
                "meta",
                "reasons",
                "request_id",
                "result"
            ],
            "properties": {
                "allow": {
                    "type": "boolean"
                },
                "decision_id": {
                    "type": "string"
                },
                "meta": {
                    "$ref": "#/definitions/auth-service_internal_model.DecisionMeta"
                },
                "reasons": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/auth-service_internal_model.DecisionReason"
                    }
                },
                "request_id": {
                    "type": "string"
                },
                "result": {
                    "type": "string"
                }
            }
        },
        "auth-service_internal_model.Consistency": {
            "type": "string",
            "enum": [
                "higher_consistency",
                "minimize_latency"
            ],
            "x-enum-varnames": [
                "HigherConsistency",
                "MinimizeLatency"
            ]
        },
        "auth-service_internal_model.DecisionAction": {
            "additionalProperties": false,
            "type": "object",
            "required": [
                "name"
            ],
            "properties": {
                "attributes": {
                    "$ref": "#/definitions/auth-service_internal_model.DecisionActionAttributes"
                },
                "name": {
                    "$ref": "#/definitions/auth-service_internal_model.ActionName"
                }
            }
        },
        "auth-service_internal_model.DecisionActionAttributes": {
            "additionalProperties": false,
            "type": "object",
            "properties": {
                "field_mask": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "role": {
                    "type": "string",
                    "enum": [
                        "viewer",
                        "editor",
                        "admin"
                    ]
                }
            }
        },
        "auth-service_internal_model.DecisionContext": {
            "additionalProperties": false,
            "type": "object",
            "properties": {
                "client": {
                    "type": "string"
                },
                "ip": {
                    "type": "string"
                },
                "service": {
                    "type": "string"
                },
                "time": {
                    "type": "string"
                },
                "trace_id": {
                    "type": "string"
                }
            }
        },
        "auth-service_internal_model.DecisionMeta": {
            "type": "object",
            "required": [
                "action",
                "authorization_model_id",
                "latency_ms",
                "policy_version",
                "resource",
                "subject"
            ],
            "properties": {
                "action": {
                    "$ref": "#/definitions/auth-service_internal_model.ActionName"
                },
                "authorization_model_id": {
                    "type": "string"
                },
                "latency_ms": {
                    "type": "integer"
                },
                "policy_version": {
                    "type": "string"
                },
                "resource": {
                    "type": "string"
                },
                "subject": {
                    "type": "string"
                }
            }
        },
        "auth-service_internal_model.DecisionOptions": {
            "additionalProperties": false,
            "type": "object",
            "properties": {
                "consistency": {
                    "default": "higher_consistency",
                    "enum": [
                        "higher_consistency",
                        "minimize_latency"
                    ],
                    "allOf": [
                        {
                            "$ref": "#/definitions/auth-service_internal_model.Consistency"
                        }
                    ]
                },
                "include_reasons": {
                    "type": "boolean",
                    "default": false
                }
            }
        },
        "auth-service_internal_model.DecisionReason": {
            "type": "object",
            "required": [
                "code",
                "message"
            ],
            "properties": {
                "code": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                }
            }
        },
        "auth-service_internal_model.DecisionResource": {
            "additionalProperties": false,
            "type": "object",
            "required": [
                "id",
                "type"
            ],
            "properties": {
                "attributes": {
                    "$ref": "#/definitions/auth-service_internal_model.DecisionResourceAttributes"
                },
                "id": {
                    "type": "string"
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "note",
                        "reminder",
                        "space",
                        "member"
                    ]
                }
            }
        },
        "auth-service_internal_model.DecisionResourceAttributes": {
            "additionalProperties": false,
            "type": "object",
            "properties": {
                "space_id": {
                    "type": "string"
                },
                "space_type": {
                    "description": "SpaceType обязателен только для space:create и задаёт тип будущего пространства.",
                    "enum": [
                        "shared",
                        "personal"
                    ],
                    "allOf": [
                        {
                            "$ref": "#/definitions/auth-service_internal_model.SpaceKind"
                        }
                    ]
                }
            }
        },
        "auth-service_internal_model.DecisionSubject": {
            "additionalProperties": false,
            "type": "object",
            "required": [
                "id",
                "type"
            ],
            "properties": {
                "attributes": {
                    "$ref": "#/definitions/auth-service_internal_model.DecisionSubjectAttributes"
                },
                "id": {
                    "type": "string"
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "user"
                    ]
                }
            }
        },
        "auth-service_internal_model.DecisionSubjectAttributes": {
            "additionalProperties": false,
            "type": "object",
            "properties": {
                "telegram_user_id": {
                    "type": "string"
                }
            }
        },
        "auth-service_internal_model.FilterNotesRequest": {
            "type": "object",
            "properties": {
                "note_ids": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "space_id": {
                    "type": "string"
                }
            }
        },
        "auth-service_internal_model.FilterNotesResponse": {
            "type": "object",
            "properties": {
                "notes": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/definitions/auth-service_internal_model.NoteAccessInfo"
                    }
                }
            }
        },
        "auth-service_internal_model.NoteAccessInfo": {
            "type": "object",
            "properties": {
                "can_edit": {
                    "description": "может ли пользователь редактировать заметку",
                    "type": "boolean"
                },
                "can_read": {
                    "type": "boolean"
                }
            }
        },
        "auth-service_internal_model.SpaceKind": {
            "type": "string",
            "enum": [
                "personal",
                "shared"
            ],
            "x-enum-varnames": [
                "SpaceKindPersonal",
                "SpaceKindShared"
            ]
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}